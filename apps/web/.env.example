# Environment variables — apps/web
# 命名规则见 docs/contracts/env-and-scripts.md §2/§4
# 启动期校验见 apps/web/src/lib/env.ts —— 缺关键变量 / 误填 ai-engine secret 都会立即报错。

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deep_research
NEXTAUTH_URL=http://localhost:3000
# ⚠️ NEXTAUTH_SECRET 在生产前必须换成强随机值：`openssl rand -hex 32`
NEXTAUTH_SECRET=replace-me
# Production Chrome extension ids allowed to receive a reading credential.
# Comma-separate multiple enterprise/Web Store ids; development may leave blank.
# Beta 0.2.3+ fixed manual-install extension ID:
# doopmkblckigfncakbfcbeajoamgmkmg
READING_EXTENSION_IDS=
# Beta ZIP distribution. Prefer a GitHub Release/object-storage URL in
# production; alternatively mount a ZIP into the web container and set PATH.
READING_EXTENSION_BETA_URL=
READING_EXTENSION_BETA_PATH=
READING_EXTENSION_BETA_VERSION=0.2.3
READING_EXTENSION_BETA_SHA256=

# BFF 服务端调用 AI engine；浏览器不直连，nginx 生产环境路由见 ADR 0001
AI_ENGINE_URL=http://localhost:4000

# Google OAuth（可选；callback 为 NEXTAUTH_URL 拼接 /api/auth/callback/google）
# 留空时 Google 登录关闭。
# ⚠️ 必须在 Google Cloud Console OAuth client 的「Authorized redirect URIs」
#    登记与 NEXTAUTH_URL 拼接的 callback URI，二者必须一字不差。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth（可选；callback 为 NEXTAUTH_URL 拼接 /api/auth/callback/github）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 兼容模式设为 1 时只显示 Google 登录，并关闭密码与 GitHub 登录。
AUTH_GOOGLE_ONLY=0
# Beta 模式只允许 Admin 预先加入白名单的邮箱创建账号。
AUTH_BETA_MODE=0
# 密码注册邮箱验证码；启用后必须配置 SMTP_HOST 与 SMTP_FROM。
AUTH_EMAIL_VERIFICATION=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Research <noreply@example.com>
# 旧 allowlist 配置保留兼容，但不再限制注册或 OAuth。
ALLOWED_EMAIL_DOMAINS=
# 旧邀请码激活接口的配置；正式登录页使用公开注册。
AUTH_INVITE_CODE=
# 默认初始管理员；使用 off/disabled 可显式关闭 bootstrap。
BOOTSTRAP_ADMIN_EMAIL=shaobo.chen@shopee.com

# 上传限制（apps/web 仅做形状校验，最终限制在 nginx）
MAX_UPLOAD_SIZE_MB=5
# Week 13 ROI 指标的时薪；Week 9 冻结，默认 $50
TIME_VALUE_USD_PER_HOUR=50

# 禁止出现在本文件：TAVILY_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY
# —— env-and-scripts.md §2 "禁止"；env.ts 的 zod strict 模式会拒绝这些字段。
