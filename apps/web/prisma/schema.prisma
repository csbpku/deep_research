// Prisma schema — Week 0 freeze
//
// 锁定基线：docs/ARCHITECTURE.md §五 + docs/IMPLEMENTATION_PLAN.md §三-十一。
// 共 12 张表。schema freeze 后工程师 A/B 不直接改；
// 修改走 [db] PR 由主会话 review，并同步 ARCHITECTURE §五 增量。
//
// 跨语言合约：packages/shared/src/states.ts 的枚举必须与下面 enum 一字不差。
// ai-engine（Python Pydantic）镜像见 docs/decisions/0002 §8（Week 1 spike 后）。

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, citext] // Week 4 中文搜索：simple 字典 + pg_trgm 字节重叠；zhparser 装机推 W5（PG16 SDK14 vs SDK26 路径阻塞 + scws 未装）
}

// ─────────────────────────────────────────────────────────────────────
// 枚举（与 packages/shared/src/states.ts 一字不差）
// ─────────────────────────────────────────────────────────────────────

enum UserRole {
  member
  admin
}

enum SummaryStatus {
  candidate
  pending_review
  published
  rejected
  archived
}

enum SummarySource {
  daily
  user
}

enum ContentOrigin {
  web
  rss
  api
  manual
}

enum ResearchStatus {
  draft
  published
  archived
}

enum ResearchType {
  research
  knowledge
}

enum CreationMethod {
  manual
  ai_research
  file_import
  confluence_import
}

enum PromoteStatus {
  none
  nominated
  approved
  rejected
}

enum AiJobStatus {
  queued
  running
  partial
  succeeded
  failed
  cancelled
}

enum AiJobStep {
  plan
  search
  compress
  analyze
  write
}

enum ImportStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum ImportSourceKind {
  file
  confluence
}

enum CommentTarget {
  research
  summary
}

// Week 4 [db]：用户分享待审核
enum ShareSubmissionStatus {
  pending
  approved
  rejected
}

// Week 4 [db]：搜索 doc 类型
enum SearchDocType {
  summary
  long_research
  knowledge
}

// Week 5 [db]：雷达候选状态（每个同步批次的候选处理阶段）
enum RadarCandidateStatus {
  new
  interpreted
  skipped
  failed
}

// Week 5 [db]：雷达同步整体状态
enum RadarSyncStatus {
  running
  completed
  partial
  failed
}

// Week 5 [db]：雷达反馈类型
enum RadarFeedbackType {
  useful
  inaccurate
  used
  favorite
  suggest_research
}

// Week 6 [db]：AI 多轮追问会话状态
enum AiChatSessionStatus {
  active
  closed
}

// Week 6 [db]：AI 多轮追问消息角色
enum AiChatRole {
  user
  assistant
}

// ─────────────────────────────────────────────────────────────────────
// 1. users
// ─────────────────────────────────────────────────────────────────────

model User {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @unique @db.Citext
  name       String    @db.VarChar(80)
  avatarUrl  String?   @db.VarChar(2048)
  role       UserRole  @default(member)
  disabledAt DateTime? @db.Timestamptz(3)
  // P1-C: per-user preferences (JsonB). Empty object by default; 应用层
  // zod 校验具体 keys（defaultReportType / defaultSourcePolicy / timezone / notifyPrefs）。
  preferences Json     @default("{}") @db.JsonB
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  // 反向
  summariesShared  Summary[]          @relation("summary_shared_by")
  researchesAuthor Research[]         @relation("research_author")
  researchAudit    ResearchAudit[]
  comments         Comment[]
  commentStars     CommentStar[]
  aiJobs           AiResearchJob[]
  importJobs       ContentImportJob[]
  productEvents    ProductEvent[]
  adminActions     AdminAction[]
  sharesSubmitted  ShareSubmission[]  @relation("share_submitter")
  sharesReviewed   ShareSubmission[]  @relation("share_reviewer")
  radarFeedback    RadarFeedback[]
  chatSessions     AiChatSession[]
  radarSubmissions RadarSubmission[] @relation("radar_submission_submitter")
  bookmarks        UserBookmark[]
  researchTemplates ResearchTemplate[]
  topicFollows     TopicFollow[]
  topicProposalReviews TopicProposal[] @relation("topic_proposal_reviewer")

  @@index([role, disabledAt])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────
// 2. summaries — 每日摘要 + 用户分享共用
// ─────────────────────────────────────────────────────────────────────

model Summary {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String        @db.VarChar(300)
  body                String        @db.Text
  url                 String        @db.VarChar(2048)
  canonicalUrl        String        @unique @db.VarChar(2048)
  source              SummarySource
  contentOrigin       ContentOrigin @default(web)
  userNote            String?       @db.VarChar(500)
  sharedByUserId      String?       @db.Uuid
  summaryDate         DateTime      @db.Date
  publishedAt         DateTime?     @db.Timestamptz(3)
  // 从 URL 抓取来的 hash，用于去重
  contentSha256       String?       @db.Char(64)
  status              SummaryStatus @default(candidate)
  // 索引与分析时使用的轻量 AI 调用计数
  ingestionTokenCount Int           @default(0)
  tags                String[]      @default([])
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  sharedBy User? @relation("summary_shared_by", fields: [sharedByUserId], references: [id], onDelete: SetNull)

  // 全文搜索（架构 §86 zhparser + tsvector/GIN；Week 4 由 prisma migration 加列）
  // 实际 tsvector 列与触发器在第二个 migration 里手工加

  // Week 5 雷达字段：评分 / 解读 / 同步批次
  relevanceScore     Float? // 相关性 0..1
  timelinessScore    Float? // 时效/趋势 0..1
  sourceQualityScore Float? // 来源质量 0..1
  scoreVersion       String?  @db.VarChar(16) // Stage 1 评分版本号
  scoreReason        String?  @db.VarChar(500) // 评分可读理由
  distilledScore     Json?    @db.JsonB // Distilled v2 完整结构化评分
  distilledTotal     Float? // Distilled 加权总分 0..100
  distilledTier      String?  @db.VarChar(16)
  distilledMustRead  Boolean?
  distilledProfile   String?  @db.VarChar(16)
  interpretation     String?  @db.VarChar(2000) // AI 一句话解读
  syncRunId          String?  @db.Uuid // radar_sync_runs.id
  sortOrder          Int? // Admin 排列的序号（每日 1-4）
  selectionReason    String?  @db.VarChar(500) // 入选每日摘要理由
  digestMeta         Json?    @db.JsonB // AI 雷达日报结构化文章；仅 canonicalUrl digest://* 使用

  // Phase 0 deep-dive 字段：sync 时抓取的原始内容，供后续 chat 读原文/结构化视图使用
  originalMarkdown  String?   @db.Text // ≤64KB markdown
  originalKind      String?   @db.VarChar(24) // github_repo | github_release | arxiv | rss | web_share
  originalFetchedAt DateTime? @db.Timestamptz(3)
  originalBytes     Int?
  originalSha256    String?   @db.Char(64)
  // Phase 2A deep-dive: enrichment metadata (GitHub repo tree + entry points).
  // Schema: { provider: "github", defaultBranch, language, stars, lastPushedAt,
  //           tree: [{path, type, size?}, ...], entryPoints: [string], fetchedAt }
  originalMeta      Json?     @db.JsonB
  // Phase 2B deep-dive: arxiv paper parsed structure.
  // tldr: AI 一句话摘要 (≤500 chars); sections: [{title, level, startOffset, endOffset}];
  // Phase 2A deep-dive fields for GitHub repo structured view.
// tree: {path, type, size?, key?}[] — file tree classified into top-level
//       buckets by the card.
// repoSummary: AI-written 500-char summary of what the repo does and how
// it works, generated by enrichment_worker._generate_repo_summary().
// Patterned after deepwiki.com's Overview + What Is sections.
  repoSummary      String?   @db.Text
  modules          Json?     @db.JsonB
  mindmap          String?   @db.Text
  // figures: [{page, bbox, caption?, dataUrl?}] (dataUrl is base64 PNG, optional);
// authors: parsed from arxiv Atom XML (cached separately from originalMarkdown).
// arxivAnalysis: 5-field structured summary (tldr/motivation/method/result/conclusion),
// generated by enrichment worker. Patterned after daily-arXiv-ai-enhanced's
// Structure pydantic schema + IMRaD conventions.
  tldr              String?   @db.VarChar(500)
  sections          Json?     @db.JsonB
  figures           Json?     @db.JsonB
  authors           String[]  @default([])
  arxivAnalysis     Json?     @db.JsonB
  highlights       Json?     @db.JsonB

  comments         Comment[]        @relation("comments_summary")
  shareSource      ShareSubmission? @relation("share_to_summary")
  syncRun          RadarSyncRun?    @relation("sync_to_candidates", fields: [syncRunId], references: [id], onDelete: SetNull)
  feedbacks        RadarFeedback[]
  seedChatSessions AiChatSession[]  @relation("summary_seed_chat")
  radarSubmission  RadarSubmission? @relation("radar_submission_to_summary")
  topicLinks       TopicCandidate[] @relation("topic_candidate_summary")
  topicProposalLinks TopicProposalCandidate[]

  @@index([source, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([summaryDate])
  @@index([sharedByUserId])
  @@index([distilledMustRead, distilledTotal(sort: Desc), createdAt(sort: Desc)])
  @@index([distilledProfile, distilledTotal(sort: Desc)])
  @@map("summaries")
}

// ─────────────────────────────────────────────────────────────────────
// 3. researches — 沉淀（长文 + 精华共用，按 type 切分）
// ─────────────────────────────────────────────────────────────────────

model Research {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        ResearchType
  status      ResearchStatus @default(draft)
  title       String         @db.VarChar(300)
  body        String         @db.Text
  background  String?        @db.VarChar(2000)
  conclusion  String?        @db.VarChar(2000)
  risks       String?        @db.VarChar(2000)
  tags        String[]       @default([]) // 架构 §十一 用 PG 数组
  authorId    String         @db.Uuid
  publishedAt DateTime?      @db.Timestamptz(3)

  // AI 协助链路（架构 §十二点五 + §五 origin_content_sha256 锁定）
  aiAssisted          Boolean        @default(false)
  creationMethod      CreationMethod @default(manual)
  originContentSha256 String?        @db.Char(64) // 阻止未修改 AI 草稿直接发布
  sourceCommentId     String?        @db.Uuid // type=knowledge 时指向源评论

  // 热点 / 统计缓存（按需；Week 1 暂留，全部为空即可）
  viewCount    Int @default(0)
  starCount    Int @default(0)
  commentCount Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  author        User     @relation("research_author", fields: [authorId], references: [id], onDelete: Restrict)
  sourceComment Comment? @relation("comment_to_knowledge", fields: [sourceCommentId], references: [id], onDelete: SetNull)

  researchSources ResearchSource[]
  audit           ResearchAudit[]
  comments        Comment[]         @relation("comments_research")
  sourceAiJob     AiResearchJob?    @relation("ai_job_draft")
  sourceImportJob ContentImportJob? @relation("import_job_output")

  @@index([type, publishedAt(sort: Desc)])
  @@index([authorId, status])
  @@index([aiAssisted])
  @@index([sourceCommentId])
  @@map("researches")
}

// ─────────────────────────────────────────────────────────────────────
// 4. research_sources — 沉淀的挂载资料（JSONB 引用形态）
// ─────────────────────────────────────────────────────────────────────

model ResearchSource {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId   String   @db.Uuid
  sourceRef    Json // {type:url|doi|arxiv|knowledge, value:"..."}
  canonicalKey String   @db.VarChar(512)
  title        String?  @db.VarChar(300)
  description  String?  @db.VarChar(1000)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  research Research @relation(fields: [researchId], references: [id], onDelete: Cascade)

  // 同一调研同一 canonical 资料不重复入库
  @@unique([researchId, canonicalKey])
  @@index([researchId])
  @@map("research_sources")
}

// ─────────────────────────────────────────────────────────────────────
// 5. ai_research_jobs — 后台 AI 调研任务
// ─────────────────────────────────────────────────────────────────────

model AiResearchJob {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId    String      @db.Uuid
  topic          String      @db.VarChar(200)
  context        String?     @db.VarChar(2000)
  reportType     String      @default("research_report") @db.VarChar(40) // research_report | summary_brief
  sourcePolicy   String      @default("prefer_user_sources") @db.VarChar(40)
  status         AiJobStatus @default(queued)
  currentStep    AiJobStep? // 最近一步；中途失败时保留
  attempts       Int         @default(0)
  // 5 步流水线中已抓取的来源快照；partial 时保留（架构 §九 风险 10）
  partialSources Json        @default("[]")
  sourceRefs     Json        @default("[]")
  failedSources  Json        @default("[]")
  // Worker 租约与心跳（架构 §十三 §3）
  lockedBy       String?
  leaseExpiresAt DateTime?   @db.Timestamptz(3)
  heartbeatAt    DateTime?   @db.Timestamptz(3)
  nextRetryAt    DateTime?   @db.Timestamptz(3)

  startedAt        DateTime? @db.Timestamptz(3)
  completedAt      DateTime? @db.Timestamptz(3)
  // 预算 / 成本埋点（架构 §九 风险 4）
  tokenInputTotal  Int       @default(0)
  tokenOutputTotal Int       @default(0)
  costCents        Int       @default(0)
  // idempotency 唯一约束；同一 (用户, key) 不重复扣费
  idempotencyKey   String?   @db.Uuid
  errorCode        String?   @db.VarChar(64)
  errorMessage     String?   @db.VarChar(500)
  // summary_brief 的终态输出；轻量摘要不创建 Research 草稿
  outputText        String?   @db.Text
  // 生成的研究草稿 id
  draftResearchId  String?   @unique @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  requester     User      @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  draftResearch Research? @relation("ai_job_draft", fields: [draftResearchId], references: [id], onDelete: SetNull)

  aiResearchSources AiResearchSource[]

  // 主队列：抢锁 ORDER BY (status, created_at)；partial index 在 SQL migration 加
  // （Prisma 5.x schema 不支持 where 限定；详见 migration init_constraints）
  @@index([status, createdAt(sort: Asc)])
  @@index([status, leaseExpiresAt])
  // @@unique([requesterId, idempotencyKey]) 改为 partial unique（idempotencyKey 非空）
  // 由 migrations/init_constraints 加，避免 PG 段 非 partial + partial unique 冲突
  @@index([requesterId, createdAt(sort: Desc)])
  @@map("ai_research_jobs")
}

// ─────────────────────────────────────────────────────────────────────
// 6. ai_research_sources — AI 调研实际抓到的资料（与 research_sources 区分）
// ─────────────────────────────────────────────────────────────────────

model AiResearchSource {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String    @db.Uuid
  sourceRef    Json // 与 research_sources.sourceRef 同 schema
  canonicalKey String    @db.VarChar(512)
  title        String?   @db.VarChar(300)
  snippet      String?   @db.VarChar(2000)
  score        Float?
  stepCaptured AiJobStep // source 是哪一步抓到的
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  job AiResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, canonicalKey])
  @@index([jobId])
  @@map("ai_research_sources")
}

// ─────────────────────────────────────────────────────────────────────
// 7. comments — 评论（用显式 FK 多态；架构 §十四 锁定）
// ─────────────────────────────────────────────────────────────────────

model Comment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId      String        @db.Uuid
  // 显式双 FK，恰好一个非空（CHECK）
  targetType    CommentTarget
  researchId    String?       @db.Uuid
  summaryId     String?       @db.Uuid
  body          String        @db.VarChar(2000)
  parentId      String?       @db.Uuid
  promoteStatus PromoteStatus @default(none)
  starCount     Int           @default(0)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  author        User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent        Comment?      @relation("comment_thread", fields: [parentId], references: [id], onDelete: SetNull)
  children      Comment[]     @relation("comment_thread")
  summary       Summary?      @relation("comments_summary", fields: [summaryId], references: [id], onDelete: Cascade)
  research      Research?     @relation("comments_research", fields: [researchId], references: [id], onDelete: Cascade)
  knowledgeFrom Research[]    @relation("comment_to_knowledge")
  stars         CommentStar[]

  @@index([summaryId, createdAt(sort: Desc)])
  @@index([researchId, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([parentId])
  @@index([promoteStatus])
  @@map("comments")
}

// ─────────────────────────────────────────────────────────────────────
// 8. comment_stars — 一人一票（架构 §十四 §2）
// ─────────────────────────────────────────────────────────────────────

model CommentStar {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("comment_stars")
}

// ─────────────────────────────────────────────────────────────────────
// 9. research_audit — 已发布调研的修改留痕（架构 §十二 锁定）
// ─────────────────────────────────────────────────────────────────────

model ResearchAudit {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId   String   @db.Uuid
  editorId     String   @db.Uuid
  // create | edit | publish | revert
  action       String   @db.VarChar(16)
  diff         Json?
  prevSnapshot Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  research Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  editor   User     @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@index([researchId, createdAt(sort: Desc)])
  @@map("research_audit")
}

// ─────────────────────────────────────────────────────────────────────
// 10. content_import_jobs — 文件导入任务（架构 §四点七 锁定）
// ─────────────────────────────────────────────────────────────────────

model ContentImportJob {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId      String           @db.Uuid
  sourceKind       ImportSourceKind
  status           ImportStatus     @default(queued)
  originalFilename String?          @db.VarChar(255)
  mimeType         String?          @db.VarChar(127)
  sizeBytes        BigInt?
  contentSha256    String?          @db.Char(64)
  // P1 Confluence 用
  sourceUrl        String?          @db.VarChar(2048)
  externalPageId   String?          @db.VarChar(255)
  externalVersion  String?          @db.VarChar(64)
  // 服务端生成路径，转换后清理；不暴露
  tempObjectKey    String?          @db.VarChar(255)
  converterVersion String           @db.VarChar(64)
  warnings         Json             @default("[]")
  errorCode        String?          @db.VarChar(64)
  errorMessage     String?          @db.VarChar(500)
  outputResearchId String?          @unique @db.Uuid
  // worker 租约（与 ai_research_jobs 同模式）
  attempts         Int              @default(0)
  lockedBy         String?
  leaseExpiresAt   DateTime?        @db.Timestamptz(3)
  heartbeatAt      DateTime?        @db.Timestamptz(3)
  nextRetryAt      DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?        @db.Timestamptz(3)

  requester      User      @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  outputResearch Research? @relation("import_job_output", fields: [outputResearchId], references: [id], onDelete: SetNull)

  // 同 (user, sha256) 在 queued/running/succeeded 中 partial unique；failed 后可重试。
  // 在 SQL migration preflight_contract_completion 加（Prisma 5.x 多条件 where 不支持）；
  // schema 层不加 non-partial unique，避免 PG 段冲突
  // @@unique([requesterId, contentSha256])
  @@index([status, createdAt(sort: Asc)])
  @@index([requesterId, createdAt(sort: Desc)])
  @@map("content_import_jobs")
}

// ─────────────────────────────────────────────────────────────────────
// 11. product_events — Week 13 决策指标事件
// ─────────────────────────────────────────────────────────────────────

model ProductEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  eventName  String   @db.VarChar(64)
  entityType String?  @db.VarChar(32)
  entityId   String?  @db.Uuid
  metadata   Json     @default("{}")
  dedupeKey  String   @unique @db.VarChar(255)
  occurredAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([eventName, occurredAt])
  @@index([userId, occurredAt])
  @@map("product_events")
}

// ─────────────────────────────────────────────────────────────────────
// 13. share_submissions — Week 4 用户分享待审核（架构 §九 风险 5）
// ─────────────────────────────────────────────────────────────────────

model ShareSubmission {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submitterId        String                @db.Uuid
  url                String                @db.VarChar(2048)
  canonicalUrl       String                @db.VarChar(2048)
  userNote           String?               @db.VarChar(500)
  // safe_fetch 抓取与摘要
  fetchedTitle       String?               @db.VarChar(300)
  fetchedMarkdown    String?               @db.Text
  summaryText        String?               @db.VarChar(2000)
  // 抓取错误：safe_fetch 失败时记录，不阻塞 pending
  fetchErrorCode     String?               @db.VarChar(64)
  fetchErrorMessage  String?               @db.VarChar(500)
  // 状态机
  status             ShareSubmissionStatus @default(pending)
  reviewerId         String?               @db.Uuid
  reviewedAt         DateTime?             @db.Timestamptz(3)
  // 批准后转为 published summary 时填；保持来源可追溯
  publishedSummaryId String?               @unique @db.Uuid
  // 抓取元数据
  contentSha256      String?               @db.Char(64)
  bytesRead          Int?
  elapsedMs          Int?
  // worker 租约
  attempts           Int                   @default(0)
  lockedBy           String?
  leaseExpiresAt     DateTime?             @db.Timestamptz(3)
  heartbeatAt        DateTime?             @db.Timestamptz(3)
  nextRetryAt        DateTime?             @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  completedAt        DateTime?             @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)

  submitter        User     @relation("share_submitter", fields: [submitterId], references: [id], onDelete: Restrict)
  reviewer         User?    @relation("share_reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  publishedSummary Summary? @relation("share_to_summary", fields: [publishedSummaryId], references: [id], onDelete: SetNull)

  // 同一用户对同一 URL 在活跃状态下唯一；failed 后允许重试
  // partial unique 由 SQL 加（Prisma 5.x 不支持 where 子句）
  @@index([status, createdAt(sort: Asc)])
  @@index([submitterId, createdAt(sort: Desc)])
  @@index([canonicalUrl])
  @@map("share_submissions")
}

// ─────────────────────────────────────────────────────────────────────
// 14. search_docs — Week 4 全文搜索集中索引（zhparser + tsvector）
// ─────────────────────────────────────────────────────────────────────

model SearchDoc {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        SearchDocType
  refId       String        @db.Uuid // summary.id / research.id
  title       String        @db.VarChar(300)
  snippet     String        @db.VarChar(1000) // 摘要片段，给搜索结果展示
  // tsvector 列与 GIN 索引由 SQL migration 加（Prisma 不支持原生 tsvector）
  // publishedAt 用于排序：未发布草稿不进 search_doc
  publishedAt DateTime      @db.Timestamptz(3)
  indexedAt   DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([type, refId])
  @@index([type, publishedAt(sort: Desc)])
  @@map("search_docs")
}

// ─────────────────────────────────────────────────────────────────────
// 15. radar_sources — Week 5 雷达预置源（GitHub/arxiv/RSS）
// ─────────────────────────────────────────────────────────────────────

model RadarSource {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(200)
  sourceType String    @db.VarChar(32) // github | arxiv | rss
  config     Json // 源特定配置：repo, category, feed URL 等
  enabled    Boolean   @default(true)
  lastSyncAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  syncRuns RadarSyncRun[]

  @@index([sourceType, enabled])
  @@map("radar_sources")
}

// ─────────────────────────────────────────────────────────────────────
// 16. radar_sync_runs — Week 5 雷达同步运行记录
// ─────────────────────────────────────────────────────────────────────

model RadarSyncRun {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId         String          @db.Uuid
  triggeredBy      String          @db.VarChar(32) // cron | admin
  status           RadarSyncStatus @default(running)
  totalFetched     Int             @default(0)
  totalNew         Int             @default(0)
  totalSkipped     Int             @default(0)
  totalFailed      Int             @default(0)
  errorCode        String?         @db.VarChar(64)
  errorMessage     String?         @db.VarChar(500)
  // 成本与性能
  tokenInputTotal  Int             @default(0)
  tokenOutputTotal Int             @default(0)
  costUsd          Float           @default(0)
  elapsedMs        Int?
  // worker 租约（复用共享 runner 契约）
  attempts         Int             @default(0)
  lockedBy         String?
  leaseExpiresAt   DateTime?       @db.Timestamptz(3)
  heartbeatAt      DateTime?       @db.Timestamptz(3)
  nextRetryAt      DateTime?       @db.Timestamptz(3)
  startedAt        DateTime?       @db.Timestamptz(3)
  completedAt      DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)

  source     RadarSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  // 候选 summaries 回指 batch（1:many）
  candidates Summary[]   @relation("sync_to_candidates")

  @@index([sourceId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Asc)])
  @@map("radar_sync_runs")
}

// ─────────────────────────────────────────────────────────────────────
// 17. radar_feedback — Week 5 用户对雷达候选的反馈
// ─────────────────────────────────────────────────────────────────────

model RadarFeedback {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  summaryId    String            @db.Uuid
  userId       String            @db.Uuid
  feedbackType RadarFeedbackType
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  summary Summary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 同一用户对同一候选的同类型反馈幂等
  @@unique([summaryId, userId, feedbackType])
  @@index([summaryId, feedbackType])
  @@index([userId, createdAt(sort: Desc)])
  @@map("radar_feedback")
}

model AdminAction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @db.Uuid
  action     String   @db.VarChar(64)
  targetType String   @db.VarChar(32)
  targetId   String   @db.Uuid
  requestId  String   @unique @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("admin_actions")
}

// ─────────────────────────────────────────────────────────────────────
// 18. ai_chat_sessions — Week 6 AI 多轮追问会话（架构 §六点一）
//   每个 session 绑定一个用户 + 一篇种子摘要快照(seedSnapshot)。
//   seedSummaryId nullable 以便后续支持 free-form 会话。
//   status 收口在 active / closed；本周 P0 默认 active，不提供关闭入口。
//   schema 必须与 docs/contracts/api-schemas.md §"Week 6 Chat API 契约" 一字不差。
// ─────────────────────────────────────────────────────────────────────

model AiChatSession {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @db.Uuid
  seedSummaryId String?             @db.Uuid
  // 创建时刻的种子摘要 JSON 快照；后续摘要更新不影响 session 历史。
  // 与契约对齐：默认空对象，让 POST handler 写入真实快照。
  seedSnapshot  Json                @default("{}")
  status        AiChatSessionStatus @default(active)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seedSummary Summary? @relation("summary_seed_chat", fields: [seedSummaryId], references: [id], onDelete: SetNull)

  messages AiChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([status, updatedAt])
  @@map("ai_chat_sessions")
}

// ─────────────────────────────────────────────────────────────────────
// 19. ai_chat_messages — Week 6 AI 多轮追问消息（架构 §六点一）
//   每个 message 属于一个 session；会话压缩（架构 §六点一）落库时只保留
//   原始 turn 行，不重写已落库的内容，避免审计丢失。
//   sourcesJson 存本轮回答引用的来源；nullable 表示尚未生成（user 消息）。
//   schema 必须与 docs/contracts/api-schemas.md §"Week 6 Chat API 契约" 一字不差。
// ─────────────────────────────────────────────────────────────────────

model AiChatMessage {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String     @db.Uuid
  role        AiChatRole
  content     String     @db.Text
  // nullable：user 消息没来源；assistant 消息也允许空。
  // 默认 NULL 让 schema 与契约 default("null") 字面对齐。
  sourcesJson Json?
  latencyMs   Int?
  tokensIn    Int?
  tokensOut   Int?
  costCents   Int?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Asc)])
  @@map("ai_chat_messages")
}

// Phase 3: Radar deep-dive inline annotations (W3C Web Annotation aligned).
//
// radar_annotations stores per-user text selection anchors against the canonical
// originalMarkdown text. radar_annotation_stars is a per-user-per-annotation
// fav toggle (same ergonomics as comment_stars). Neither uses a @relation on
// Summary because the Prisma relation traversal was broken by the model order
// and scaffolding regeneration is fragile—we use raw SQL instead.

// ─────────────────────────────────────────────────────────────────────
// 20. radar_tracked_repos — Week 13 自动跟踪的 GitHub 仓库
//    status: tracking=正常跟踪, pinned=手动固定, archived=已归档/降级
//    由 sync 后的 post-processing 自动维护
// ─────────────────────────────────────────────────────────────────────

enum RadarTrackedRepoStatus {
  tracking
  pinned
  archived
}

// ─────────────────────────────────────────────────────────────────────
// P1-B: 雷达主动输入（ADR 0007）
//   URL / 文件入口统一进 radar_submissions，状态机：
//   received → type_detected → extracting → scoring → enriching → completed | duplicate | failed
//   partial unique 索引由 SQL migration 加（Prisma 5.x 不支持）。
// ─────────────────────────────────────────────────────────────────────

enum RadarSubmissionStatus {
  received
  type_detected
  extracting
  scoring
  enriching
  completed
  duplicate
  failed
}

enum RadarSubmissionKind {
  github_repo
  github_issue
  github_pr
  github_release
  arxiv
  article
  pdf
  markdown
  html
  txt
}

model RadarSubmission {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submitterId   String                @db.Uuid
  kind          RadarSubmissionKind
  rawInput      String                @db.VarChar(2048)
  // URL 类提交：用户提交的 URL + canonical 形式（用于去重）
  canonicalUrl  String?               @db.VarChar(2048)
  // 文件类提交：内容 SHA-256（用于去重）
  contentSha256 String?               @db.Char(64)
  // 类型识别结果（可能与 kind 不同：用户标 arxiv 但实际是 github_repo）
  detectedKind  RadarSubmissionKind?
  status        RadarSubmissionStatus @default(received)
  errorCode     String?               @db.VarChar(64)
  errorMessage  String?               @db.VarChar(500)
  // completed 时填：已生成的候选 summary id
  summaryId     String?               @unique @db.Uuid
  // worker 租约（与 content_import_jobs 同模式）
  attempts      Int                   @default(0)
  lockedBy      String?               @db.VarChar(64)
  leaseExpiresAt DateTime?            @db.Timestamptz(3)
  heartbeatAt    DateTime?            @db.Timestamptz(3)
  nextRetryAt    DateTime?            @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?            @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)

  submitter User     @relation("radar_submission_submitter", fields: [submitterId], references: [id], onDelete: Restrict)
  summary   Summary? @relation("radar_submission_to_summary", fields: [summaryId], references: [id], onDelete: SetNull)

  // 同一用户对同一 URL 在非终态唯一（partial unique 由 SQL migration 加）
  @@index([status, createdAt(sort: Asc)])
  @@index([submitterId, createdAt(sort: Desc)])
  @@index([canonicalUrl])
  @@index([contentSha256])
  @@map("radar_submissions")
}

// ─────────────────────────────────────────────────────────────────────
// P1-C: "我的"菜单 (ADR 0008)
//   user_bookmarks: 统一收藏 (radar_candidate / summary / research / knowledge / daily_digest)
//   research_templates: 调研模板（owner 用一次拷贝出 Research 草稿）
//   User.preferences: per-user 设置 (JsonB)
// ─────────────────────────────────────────────────────────────────────

enum BookmarkTargetType {
  radar_candidate
  summary
  research
  knowledge
  daily_digest
}

model UserBookmark {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String             @db.Uuid
  targetType BookmarkTargetType
  targetId   String             @db.Uuid
  note       String?            @db.VarChar(500)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("user_bookmarks")
}

model ResearchTemplate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String   @db.Uuid
  title        String   @db.VarChar(200)
  topic        String   @db.VarChar(200)
  background   String?  @db.VarChar(2000)
  reportType   String   @default("research_report") @db.VarChar(40)
  sourcePolicy String   @default("prefer_user_sources") @db.VarChar(40)
  tags         String[] @default([])
  useCount     Int      @default(0)
  lastUsedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("research_templates")
}

// ─────────────────────────────────────────────────────────────────────
// P1-D: 热点主题 V1 (ADR 0009)
//   topics: 主题（slug 唯一，tier = hot / warming / emerging）
//   topic_candidates: topic ↔ summary 多对多 + 相似度
//   topic_follows: 用户关注
// ─────────────────────────────────────────────────────────────────────

enum TopicTier {
  hot
  warming
  emerging
}

enum TopicCandidateReason {
  auto
  admin_manual
}

enum TopicProposalStatus {
  proposed
  approved
  rejected
  expired
}

enum TopicProposalKind {
  event
  problem
}

model Topic {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                     String    @unique @db.VarChar(120)
  name                     String    @db.VarChar(200)
  summary                  String?   @db.VarChar(2000)
  tier                     TopicTier @default(emerging)
  candidateCount           Int       @default(0)
  sourceCount              Int       @default(0)
  aggregationWindowStart   DateTime  @db.Timestamptz(3)
  aggregationWindowEnd     DateTime  @db.Timestamptz(3)
  lastSyncedAt             DateTime? @db.Timestamptz(3)
  synthesisGeneratedAt     DateTime? @db.Timestamptz(3)
  synthesisModel           String?   @db.VarChar(64)
  synthesisVersion         String?   @db.VarChar(16)
  synthesisPayload         Json?     @db.JsonB
  synthesisErrorCode       String?   @db.VarChar(64)
  synthesisErrorMessage    String?   @db.VarChar(500)
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)

  candidates TopicCandidate[]
  followers  TopicFollow[]

  @@index([tier, candidateCount(sort: Desc), updatedAt(sort: Desc)])
  @@index([aggregationWindowEnd(sort: Desc)])
  @@map("topics")
}

model TopicCandidate {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId         String               @db.Uuid
  summaryId       String               @db.Uuid
  similarityScore Float?
  addedAt         DateTime             @default(now()) @db.Timestamptz(3)
  addedReason     TopicCandidateReason @default(auto)

  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  summary Summary @relation("topic_candidate_summary", fields: [summaryId], references: [id], onDelete: Cascade)

  @@unique([topicId, summaryId])
  @@index([summaryId])
  @@map("topic_candidates")
}

model TopicFollow {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  topicId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([topicId, createdAt(sort: Desc)])
  @@map("topic_follows")
}

// Algorithm output stays here until an admin verifies the shared proposition.
// Only approved proposals are materialized into the public Topic tables.
model TopicProposal {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalKey      String              @unique @db.VarChar(64)
  name             String              @db.VarChar(200)
  proposition      String              @db.VarChar(1000)
  kind             TopicProposalKind
  status           TopicProposalStatus @default(proposed)
  confidence       Float?
  candidateCount   Int                 @default(0)
  sourceCount      Int                 @default(0)
  windowStart      DateTime            @db.Timestamptz(3)
  windowEnd        DateTime            @db.Timestamptz(3)
  algorithmVersion String              @db.VarChar(32)
  evidence         Json                @default("{}")
  publishedTopicId String?             @unique @db.Uuid
  reviewerId       String?             @db.Uuid
  reviewReason     String?             @db.VarChar(500)
  reviewedAt       DateTime?           @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  reviewer   User?                   @relation("topic_proposal_reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  candidates TopicProposalCandidate[]

  @@index([status, createdAt(sort: Desc)])
  @@index([windowEnd(sort: Desc)])
  @@map("topic_proposals")
}

model TopicProposalCandidate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalId      String   @db.Uuid
  summaryId       String   @db.Uuid
  fitScore        Float?
  evidence        String?  @db.VarChar(500)
  included        Boolean  @default(true)
  exclusionReason String?  @db.VarChar(300)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  proposal TopicProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  summary  Summary       @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@unique([proposalId, summaryId])
  @@index([summaryId])
  @@map("topic_proposal_candidates")
}


model RadarTrackedRepo {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerRepo       String                  @unique @db.VarChar(200) // "owner/repo"
  status          RadarTrackedRepoStatus  @default(tracking)
  // 来自 GitHub Trending 的信号计数（7天滑动窗口）
  signalCount7d   Int                     @default(0)
  // 最近一次在 Trending 中出现的时间
  lastSignalAt    DateTime?               @db.Timestamptz(3)
  // 最近一次有 GitHub 活动（issues/PRs/releases）
  lastActivityAt  DateTime?               @db.Timestamptz(3)
  // 首次发现时间
  firstSeenAt     DateTime                @default(now()) @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(3)

  @@index([status, signalCount7d(sort: Desc)])
  @@index([status, lastActivityAt(sort: Desc)])  
  @@map("radar_tracked_repos")
}
