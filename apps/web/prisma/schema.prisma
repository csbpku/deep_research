// Prisma schema — Week 0 freeze
//
// 锁定基线：docs/ARCHITECTURE.md §五 + docs/IMPLEMENTATION_PLAN.md §三-十一。
// 共 12 张表。schema freeze 后工程师 A/B 不直接改；
// 修改走 [db] PR 由主会话 review，并同步 ARCHITECTURE §五 增量。
//
// 跨语言合约：packages/shared/src/states.ts 的枚举必须与下面 enum 一字不差。
// ai-engine（Python Pydantic）镜像见 docs/decisions/0002 §8（Week 1 spike 后）。

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, citext]  // Week 4 中文搜索：simple 字典 + pg_trgm 字节重叠；zhparser 装机推 W5（PG16 SDK14 vs SDK26 路径阻塞 + scws 未装）
}

// ─────────────────────────────────────────────────────────────────────
// 枚举（与 packages/shared/src/states.ts 一字不差）
// ─────────────────────────────────────────────────────────────────────

enum UserRole {
  member
  admin
}

enum SummaryStatus {
  candidate
  pending_review
  published
  rejected
  archived
}

enum SummarySource {
  daily
  user
}

enum ContentOrigin {
  web
  rss
  api
  manual
}

enum ResearchStatus {
  draft
  published
  archived
}

enum ResearchType {
  research
  knowledge
}

enum CreationMethod {
  manual
  ai_research
  file_import
  confluence_import
}

enum PromoteStatus {
  none
  nominated
  approved
  rejected
}

enum AiJobStatus {
  queued
  running
  partial
  succeeded
  failed
  cancelled
}

enum AiJobStep {
  plan
  search
  compress
  analyze
  write
}

enum ImportStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum ImportSourceKind {
  file
  confluence
}

enum CommentTarget {
  research
  summary
}

// Week 4 [db]：用户分享待审核
enum ShareSubmissionStatus {
  pending
  approved
  rejected
}

// Week 4 [db]：搜索 doc 类型
enum SearchDocType {
  summary
  long_research
  knowledge
}

// Week 5 [db]：雷达候选状态（每个同步批次的候选处理阶段）
enum RadarCandidateStatus {
  new
  interpreted
  skipped
  failed
}

// Week 5 [db]：雷达同步整体状态
enum RadarSyncStatus {
  running
  completed
  partial
  failed
}

// Week 5 [db]：雷达反馈类型
enum RadarFeedbackType {
  useful
  inaccurate
  used
  favorite
  suggest_research
}

// ─────────────────────────────────────────────────────────────────────
// 1. users
// ─────────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique @db.Citext
  name          String     @db.VarChar(80)
  avatarUrl     String?    @db.VarChar(2048)
  role          UserRole   @default(member)
  disabledAt    DateTime?  @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  // 反向
  summariesShared   Summary[]        @relation("summary_shared_by")
  researchesAuthor  Research[]       @relation("research_author")
  researchAudit     ResearchAudit[]
  comments          Comment[]
  commentStars      CommentStar[]
  aiJobs            AiResearchJob[]
  importJobs        ContentImportJob[]
  productEvents     ProductEvent[]
  adminActions      AdminAction[]
  sharesSubmitted   ShareSubmission[] @relation("share_submitter")
  sharesReviewed    ShareSubmission[] @relation("share_reviewer")
  radarFeedback     RadarFeedback[]

  @@index([role, disabledAt])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────
// 2. summaries — 每日摘要 + 用户分享共用
// ─────────────────────────────────────────────────────────────────────

model Summary {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String         @db.VarChar(300)
  body                String         @db.Text
  url                 String         @db.VarChar(2048)
  canonicalUrl        String         @unique @db.VarChar(2048)
  source              SummarySource
  contentOrigin       ContentOrigin  @default(web)
  userNote            String?        @db.VarChar(500)
  sharedByUserId      String?        @db.Uuid
  summaryDate         DateTime       @db.Date
  publishedAt         DateTime?      @db.Timestamptz(3)
  // 从 URL 抓取来的 hash，用于去重
  contentSha256       String?        @db.Char(64)
  status              SummaryStatus  @default(candidate)
  // 索引与分析时使用的轻量 AI 调用计数
  ingestionTokenCount Int            @default(0)
  tags                String[]       @default([])
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  sharedBy            User?          @relation("summary_shared_by", fields: [sharedByUserId], references: [id], onDelete: SetNull)

  // 全文搜索（架构 §86 zhparser + tsvector/GIN；Week 4 由 prisma migration 加列）
  // 实际 tsvector 列与触发器在第二个 migration 里手工加

  // Week 5 雷达字段：评分 / 解读 / 同步批次
  relevanceScore      Float?              // 相关性 0..1
  timelinessScore     Float?              // 时效/趋势 0..1
  sourceQualityScore  Float?              // 来源质量 0..1
  scoreVersion        String?             @db.VarChar(16)  // 评分版本号
  scoreReason         String?             @db.VarChar(500)  // 评分可读理由
  interpretation      String?             @db.VarChar(2000) // AI 一句话解读
  syncRunId           String?             @db.Uuid  // radar_sync_runs.id
  sortOrder           Int?                // Admin 排列的序号（每日 1-4）
  selectionReason     String?             @db.VarChar(500)  // 入选每日摘要理由

  comments            Comment[]      @relation("comments_summary")
  shareSource         ShareSubmission? @relation("share_to_summary")
  syncRun             RadarSyncRun?     @relation("sync_to_candidates", fields: [syncRunId], references: [id], onDelete: SetNull)
  feedbacks           RadarFeedback[]

  @@index([source, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([summaryDate])
  @@index([sharedByUserId])
  @@map("summaries")
}

// ─────────────────────────────────────────────────────────────────────
// 3. researches — 沉淀（长文 + 精华共用，按 type 切分）
// ─────────────────────────────────────────────────────────────────────

model Research {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                   ResearchType
  status                 ResearchStatus @default(draft)
  title                  String         @db.VarChar(300)
  body                   String         @db.Text
  background             String?        @db.VarChar(2000)
  conclusion             String?        @db.VarChar(2000)
  risks                  String?        @db.VarChar(2000)
  tags                   String[]       @default([])            // 架构 §十一 用 PG 数组
  authorId               String         @db.Uuid
  publishedAt            DateTime?      @db.Timestamptz(3)

  // AI 协助链路（架构 §十二点五 + §五 origin_content_sha256 锁定）
  aiAssisted             Boolean        @default(false)
  creationMethod         CreationMethod @default(manual)
  originContentSha256    String?        @db.Char(64)             // 阻止未修改 AI 草稿直接发布
  sourceCommentId        String?        @db.Uuid                 // type=knowledge 时指向源评论

  // 热点 / 统计缓存（按需；Week 1 暂留，全部为空即可）
  viewCount              Int            @default(0)
  starCount              Int            @default(0)
  commentCount           Int            @default(0)

  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)

  author                 User           @relation("research_author", fields: [authorId], references: [id], onDelete: Restrict)
  sourceComment          Comment?       @relation("comment_to_knowledge", fields: [sourceCommentId], references: [id], onDelete: SetNull)

  researchSources        ResearchSource[]
  audit                  ResearchAudit[]
  comments               Comment[]      @relation("comments_research")
  sourceAiJob            AiResearchJob? @relation("ai_job_draft")
  sourceImportJob        ContentImportJob? @relation("import_job_output")

  @@index([type, publishedAt(sort: Desc)])
  @@index([authorId, status])
  @@index([aiAssisted])
  @@index([sourceCommentId])
  @@map("researches")
}

// ─────────────────────────────────────────────────────────────────────
// 4. research_sources — 沉淀的挂载资料（JSONB 引用形态）
// ─────────────────────────────────────────────────────────────────────

model ResearchSource {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId    String   @db.Uuid
  sourceRef     Json     // {type:url|doi|arxiv|knowledge, value:"..."}
  canonicalKey  String   @db.VarChar(512)
  title         String?  @db.VarChar(300)
  description   String?  @db.VarChar(1000)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  research      Research @relation(fields: [researchId], references: [id], onDelete: Cascade)

  // 同一调研同一 canonical 资料不重复入库
  @@unique([researchId, canonicalKey])
  @@index([researchId])
  @@map("research_sources")
}

// ─────────────────────────────────────────────────────────────────────
// 5. ai_research_jobs — 后台 AI 调研任务
// ─────────────────────────────────────────────────────────────────────

model AiResearchJob {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId       String        @db.Uuid
  topic             String        @db.VarChar(200)
  context           String?       @db.VarChar(2000)
  reportType        String        @default("research_report") @db.VarChar(40)  // research_report | summary_brief
  sourcePolicy      String        @default("prefer_user_sources") @db.VarChar(40)
  status            AiJobStatus   @default(queued)
  currentStep       AiJobStep?    // 最近一步；中途失败时保留
  attempts          Int           @default(0)
  // 5 步流水线中已抓取的来源快照；partial 时保留（架构 §九 风险 10）
  partialSources    Json          @default("[]")
  sourceRefs        Json          @default("[]")
  failedSources     Json          @default("[]")
  // Worker 租约与心跳（架构 §十三 §3）
  lockedBy          String?
  leaseExpiresAt    DateTime?     @db.Timestamptz(3)
  heartbeatAt       DateTime?     @db.Timestamptz(3)
  nextRetryAt       DateTime?     @db.Timestamptz(3)

  startedAt         DateTime?     @db.Timestamptz(3)
  completedAt       DateTime?     @db.Timestamptz(3)
  // 预算 / 成本埋点（架构 §九 风险 4）
  tokenInputTotal   Int           @default(0)
  tokenOutputTotal  Int           @default(0)
  costCents         Int           @default(0)
  // idempotency 唯一约束；同一 (用户, key) 不重复扣费
  idempotencyKey    String?       @db.Uuid
  errorCode         String?       @db.VarChar(64)
  errorMessage      String?       @db.VarChar(500)
  // 生成的研究草稿 id
  draftResearchId   String?       @unique @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  requester         User          @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  draftResearch     Research?     @relation("ai_job_draft", fields: [draftResearchId], references: [id], onDelete: SetNull)

  aiResearchSources AiResearchSource[]

  // 主队列：抢锁 ORDER BY (status, created_at)；partial index 在 SQL migration 加
  // （Prisma 5.x schema 不支持 where 限定；详见 migration init_constraints）
  @@index([status, createdAt(sort: Asc)])
  @@index([status, leaseExpiresAt])
  // @@unique([requesterId, idempotencyKey]) 改为 partial unique（idempotencyKey 非空）
  // 由 migrations/init_constraints 加，避免 PG 段 非 partial + partial unique 冲突
  @@index([requesterId, createdAt(sort: Desc)])
  @@map("ai_research_jobs")
}

// ─────────────────────────────────────────────────────────────────────
// 6. ai_research_sources — AI 调研实际抓到的资料（与 research_sources 区分）
// ─────────────────────────────────────────────────────────────────────

model AiResearchSource {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String        @db.Uuid
  sourceRef     Json          // 与 research_sources.sourceRef 同 schema
  canonicalKey  String        @db.VarChar(512)
  title         String?       @db.VarChar(300)
  snippet       String?       @db.VarChar(2000)
  score         Float?
  stepCaptured  AiJobStep     // source 是哪一步抓到的
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  job           AiResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, canonicalKey])
  @@index([jobId])
  @@map("ai_research_sources")
}

// ─────────────────────────────────────────────────────────────────────
// 7. comments — 评论（用显式 FK 多态；架构 §十四 锁定）
// ─────────────────────────────────────────────────────────────────────

model Comment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId       String        @db.Uuid
  // 显式双 FK，恰好一个非空（CHECK）
  targetType     CommentTarget
  researchId     String?       @db.Uuid
  summaryId      String?       @db.Uuid
  body           String        @db.VarChar(2000)
  parentId       String?       @db.Uuid
  promoteStatus  PromoteStatus @default(none)
  starCount      Int           @default(0)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  author         User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent         Comment?      @relation("comment_thread", fields: [parentId], references: [id], onDelete: SetNull)
  children       Comment[]     @relation("comment_thread")
  summary        Summary?      @relation("comments_summary", fields: [summaryId], references: [id], onDelete: Cascade)
  research       Research?     @relation("comments_research", fields: [researchId], references: [id], onDelete: Cascade)
  knowledgeFrom  Research[]    @relation("comment_to_knowledge")
  stars          CommentStar[]

  @@index([summaryId, createdAt(sort: Desc)])
  @@index([researchId, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([parentId])
  @@index([promoteStatus])
  @@map("comments")
}

// ─────────────────────────────────────────────────────────────────────
// 8. comment_stars — 一人一票（架构 §十四 §2）
// ─────────────────────────────────────────────────────────────────────

model CommentStar {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commentId    String   @db.Uuid
  userId       String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  comment      Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("comment_stars")
}

// ─────────────────────────────────────────────────────────────────────
// 9. research_audit — 已发布调研的修改留痕（架构 §十二 锁定）
// ─────────────────────────────────────────────────────────────────────

model ResearchAudit {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId    String   @db.Uuid
  editorId      String   @db.Uuid
  // create | edit | publish | revert
  action        String   @db.VarChar(16)
  diff          Json?
  prevSnapshot  Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  research      Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  editor        User     @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@index([researchId, createdAt(sort: Desc)])
  @@map("research_audit")
}

// ─────────────────────────────────────────────────────────────────────
// 10. content_import_jobs — 文件导入任务（架构 §四点七 锁定）
// ─────────────────────────────────────────────────────────────────────

model ContentImportJob {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId         String         @db.Uuid
  sourceKind          ImportSourceKind
  status              ImportStatus   @default(queued)
  originalFilename    String?        @db.VarChar(255)
  mimeType            String?        @db.VarChar(127)
  sizeBytes           BigInt?
  contentSha256       String?        @db.Char(64)
  // P1 Confluence 用
  sourceUrl           String?        @db.VarChar(2048)
  externalPageId      String?        @db.VarChar(255)
  externalVersion     String?        @db.VarChar(64)
  // 服务端生成路径，转换后清理；不暴露
  tempObjectKey       String?        @db.VarChar(255)
  converterVersion    String         @db.VarChar(64)
  warnings            Json           @default("[]")
  errorCode           String?        @db.VarChar(64)
  errorMessage        String?        @db.VarChar(500)
  outputResearchId    String?        @unique @db.Uuid
  // worker 租约（与 ai_research_jobs 同模式）
  attempts            Int            @default(0)
  lockedBy            String?
  leaseExpiresAt      DateTime?      @db.Timestamptz(3)
  heartbeatAt         DateTime?      @db.Timestamptz(3)
  nextRetryAt         DateTime?      @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  completedAt         DateTime?      @db.Timestamptz(3)

  requester           User           @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  outputResearch      Research?      @relation("import_job_output", fields: [outputResearchId], references: [id], onDelete: SetNull)

  // 同 (user, sha256) 在 queued/running/succeeded 中 partial unique；failed 后可重试。
  // 在 SQL migration preflight_contract_completion 加（Prisma 5.x 多条件 where 不支持）；
  // schema 层不加 non-partial unique，避免 PG 段冲突
  // @@unique([requesterId, contentSha256])
  @@index([status, createdAt(sort: Asc)])
  @@index([requesterId, createdAt(sort: Desc)])
  @@map("content_import_jobs")
}

// ─────────────────────────────────────────────────────────────────────
// 11. product_events — Week 13 决策指标事件
// ─────────────────────────────────────────────────────────────────────

model ProductEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  eventName    String   @db.VarChar(64)
  entityType   String?  @db.VarChar(32)
  entityId     String?  @db.Uuid
  metadata     Json     @default("{}")
  dedupeKey    String   @unique @db.VarChar(255)
  occurredAt   DateTime @default(now()) @db.Timestamptz(3)

  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([eventName, occurredAt])
  @@index([userId, occurredAt])
  @@map("product_events")
}

// ─────────────────────────────────────────────────────────────────────
// 13. share_submissions — Week 4 用户分享待审核（架构 §九 风险 5）
// ─────────────────────────────────────────────────────────────────────

model ShareSubmission {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submitterId     String                @db.Uuid
  url             String                @db.VarChar(2048)
  canonicalUrl    String                @db.VarChar(2048)
  userNote        String?               @db.VarChar(500)
  // safe_fetch 抓取与摘要
  fetchedTitle    String?               @db.VarChar(300)
  fetchedMarkdown String?               @db.Text
  summaryText     String?               @db.VarChar(2000)
  // 抓取错误：safe_fetch 失败时记录，不阻塞 pending
  fetchErrorCode  String?               @db.VarChar(64)
  fetchErrorMessage String?             @db.VarChar(500)
  // 状态机
  status          ShareSubmissionStatus @default(pending)
  reviewerId      String?               @db.Uuid
  reviewedAt      DateTime?             @db.Timestamptz(3)
  // 批准后转为 published summary 时填；保持来源可追溯
  publishedSummaryId String?            @unique @db.Uuid
  // 抓取元数据
  contentSha256   String?               @db.Char(64)
  bytesRead       Int?
  elapsedMs       Int?
  // worker 租约
  attempts        Int                   @default(0)
  lockedBy        String?
  leaseExpiresAt  DateTime?             @db.Timestamptz(3)
  heartbeatAt     DateTime?             @db.Timestamptz(3)
  nextRetryAt     DateTime?             @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  completedAt     DateTime?             @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)

  submitter       User                  @relation("share_submitter", fields: [submitterId], references: [id], onDelete: Restrict)
  reviewer        User?                 @relation("share_reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  publishedSummary Summary?             @relation("share_to_summary", fields: [publishedSummaryId], references: [id], onDelete: SetNull)

  // 同一用户对同一 URL 在活跃状态下唯一；failed 后允许重试
  // partial unique 由 SQL 加（Prisma 5.x 不支持 where 子句）
  @@index([status, createdAt(sort: Asc)])
  @@index([submitterId, createdAt(sort: Desc)])
  @@index([canonicalUrl])
  @@map("share_submissions")
}

// ─────────────────────────────────────────────────────────────────────
// 14. search_docs — Week 4 全文搜索集中索引（zhparser + tsvector）
// ─────────────────────────────────────────────────────────────────────

model SearchDoc {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        SearchDocType
  refId       String        @db.Uuid              // summary.id / research.id
  title       String        @db.VarChar(300)
  snippet     String        @db.VarChar(1000)     // 摘要片段，给搜索结果展示
  // tsvector 列与 GIN 索引由 SQL migration 加（Prisma 不支持原生 tsvector）
  // publishedAt 用于排序：未发布草稿不进 search_doc
  publishedAt DateTime      @db.Timestamptz(3)
  indexedAt   DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([type, refId])
  @@index([type, publishedAt(sort: Desc)])
  @@map("search_docs")
}

// ─────────────────────────────────────────────────────────────────────
// 15. radar_sources — Week 5 雷达预置源（GitHub/arxiv/RSS）
// ─────────────────────────────────────────────────────────────────────

model RadarSource {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @db.VarChar(200)
  sourceType      String   @db.VarChar(32)  // github | arxiv | rss
  config          Json                        // 源特定配置：repo, category, feed URL 等
  enabled         Boolean  @default(true)
  lastSyncAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  syncRuns        RadarSyncRun[]

  @@index([sourceType, enabled])
  @@map("radar_sources")
}

// ─────────────────────────────────────────────────────────────────────
// 16. radar_sync_runs — Week 5 雷达同步运行记录
// ─────────────────────────────────────────────────────────────────────

model RadarSyncRun {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId        String           @db.Uuid
  triggeredBy     String           @db.VarChar(32)  // cron | admin
  status          RadarSyncStatus  @default(running)
  totalFetched    Int              @default(0)
  totalNew        Int              @default(0)
  totalSkipped    Int              @default(0)
  totalFailed     Int              @default(0)
  errorCode       String?          @db.VarChar(64)
  errorMessage    String?          @db.VarChar(500)
  // 成本与性能
  tokenInputTotal  Int             @default(0)
  tokenOutputTotal Int             @default(0)
  costUsd         Float            @default(0)
  elapsedMs       Int?
  // worker 租约（复用共享 runner 契约）
  attempts        Int              @default(0)
  lockedBy        String?
  leaseExpiresAt  DateTime?        @db.Timestamptz(3)
  heartbeatAt     DateTime?        @db.Timestamptz(3)
  nextRetryAt     DateTime?        @db.Timestamptz(3)
  startedAt       DateTime?        @db.Timestamptz(3)
  completedAt     DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  source          RadarSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  // 候选 summaries 回指 batch（1:many）
  candidates      Summary[]        @relation("sync_to_candidates")

  @@index([sourceId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Asc)])
  @@map("radar_sync_runs")
}

// ─────────────────────────────────────────────────────────────────────
// 17. radar_feedback — Week 5 用户对雷达候选的反馈
// ─────────────────────────────────────────────────────────────────────

model RadarFeedback {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  summaryId       String            @db.Uuid
  userId          String            @db.Uuid
  feedbackType    RadarFeedbackType
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  summary         Summary           @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 同一用户对同一候选的同类型反馈幂等
  @@unique([summaryId, userId, feedbackType])
  @@index([summaryId, feedbackType])
  @@index([userId, createdAt(sort: Desc)])
  @@map("radar_feedback")
}

model AdminAction {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId      String   @db.Uuid
  action       String   @db.VarChar(64)
  targetType   String   @db.VarChar(32)
  targetId     String   @db.Uuid
  requestId    String   @unique @db.Uuid
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  actor        User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("admin_actions")
}
