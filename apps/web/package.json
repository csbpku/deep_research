{
  "name": "@deep-research/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "worker:run": "tsx src/worker/index.ts",
    "worker:lease-recover": "tsx src/worker/recover.ts"
  },
  "dependencies": {
    "@deep-research/shared": "workspace:*",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-query": "^5.59.0",
    "next-auth": "^5.0.0-beta.22",
    "@auth/prisma-adapter": "^2.7.0",
    "@prisma/client": "^5.22.0",
    "zod": "^3.23.0",
    "shadcn-ui": "latest",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "prisma": "^5.22.0",
    "vitest": "^2.1.0",
    "@vitejs/plugin-react": "^4.3.0"
  }
