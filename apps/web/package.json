{
  "name": "@deep-research/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build && node scripts/strip-standalone-env.mjs",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config ./playwright.config.ts",
    "test:e2e:headed": "playwright test --config ./playwright.config.ts --headed",
    "perf:first-visit": "node scripts/production-like-first-visit.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "db:seed:e2e": "tsx prisma/seed-e2e.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "bootstrap:radar": "tsx scripts/bootstrap-radar-sources.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@deep-research/shared": "workspace:*",
    "@deep-research/design-system": "workspace:*",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@emotion/server": "11.11.0",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.59.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.460.0",
    "mermaid": "^11.17.2",
    "next": "^15.5.24",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.4",
    "nodemailer": "^9.1.1",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
