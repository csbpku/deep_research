# AI engine env
# 命名见 docs/contracts/env-and-scripts.md
#
# 主引擎: gpt-researcher (ADR 0004, 2026-07-27 复评通过)
# LLM 通过 LangChain provider 抽象,支持 anthropic / openai 等。
# 本地开发可使用 cc-switch (Anthropic 兼容) 或 vibeproxy (OpenAI 兼容)。
# VPS 默认 DeepSeek API；其他部署者可填写任一兼容端点和 API key。
#
# SMART_LLM 格式: <provider>:<model> (gpt-researcher 0.15.x 要求)

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deep_research
TAVILY_API_KEY=

# The setup script prompts for provider, endpoint, key, and model. It first
# tries `${BASE_URL}/models`, then allows manual model entry. The selected
# `<provider>:<model>` is copied to all four runtime slots. Values below are
# examples only, not universal defaults.
# VPS default: DeepSeek OpenAI-compatible endpoint
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
# Local cc-switch (Anthropic-compatible): http://localhost:15721
# Local ais-switch (OpenAI-compatible): http://localhost:15722/v1
# Local vibeproxy (OpenAI-compatible): http://localhost:8318/v1
# In --quick/fake mode setup writes anthropic:deepseek-v4-flash to all slots.
SMART_LLM=anthropic:MiniMax-M3
FAST_LLM=anthropic:MiniMax-M3
STRATEGIC_LLM=anthropic:MiniMax-M3
BRIEF_LLM=anthropic:MiniMax-M3
# Quota/rate-limit fallback used by every shared LLM call.
LLM_FALLBACK_LLM=anthropic:deepseek-v4-flash
LLM_USAGE_AUDIT_ENABLED=true

# Provider credentials. The *_LLM slots above are the runtime source of truth;
# *_MODEL values are compatibility hints for provider-specific clients.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Heavy credentials are optional and fall back to the light credentials.
ANTHROPIC_API_KEY_HEAVY=
ANTHROPIC_BASE_URL_HEAVY=

# OpenAI-compatible credentials (OpenAI, DeepSeek OpenAI API, vibeproxy).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY_HEAVY=
OPENAI_BASE_URL_HEAVY=

GH_TOKEN=

# Product Hunt GraphQL API token. Required for the producthunt radar source
# to fetch real data. Operators can mint a developer token at
# https://api.producthunt.com/v2/oauth/applications — leave blank to disable
# the source (the radar_sync_diagnostics page will surface the row as failed).
PRODUCTHUNT_API_TOKEN=

# Adapter selection (default: gpt_researcher; fake for tests/CI)
AI_ENGINE_ADAPTER=gpt_researcher

# Radar deep-dive feature flag (Phase 0+). When true, sync captures
# original content into summaries.originalMarkdown. When false, behaves
# as Week 9 (no capture, no UI surface).
RADAR_DEEPDIVE_ENABLED=true

# Worker
WORKER_LEASE_SECONDS=1020
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_RETRIES=3
WORKER_REAPER_INTERVAL_SECONDS=30
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Radar concurrency
RADAR_SOURCE_CONCURRENCY=5
RADAR_CANDIDATE_CONCURRENCY=3
RADAR_LLM_CONCURRENCY=8
RADAR_SCORING_CONCURRENCY=8
RADAR_ENRICHMENT_CONCURRENCY=2
# Daily cron compensation: retry only failed/partial sources and stages.
RADAR_SOURCE_RETRIES=2
RADAR_SOURCE_RETRY_BACKOFF_SECONDS=10
# Retry an HTTP-200 page when extraction returns an empty/blocked shell.
RADAR_CONTENT_RETRIES=1
RADAR_CONTENT_RETRY_BACKOFF_SECONDS=1
RADAR_RATE_LIMIT_RETRY_BACKOFF_SECONDS=60
RADAR_ENRICHMENT_RETRIES=2
RADAR_SYNC_CRON_ENABLED=1
# P1.6: 02:00 daily full sweep anchors the tiered loop (which otherwise
# only runs due sources). Per-source cadence is governed by the
# _RADAR_DEFAULT_TIER_MINUTES table in ai_engine/server/app.py.
RADAR_SYNC_CRON_TIME=02:00
# Generate review-only topic proposals after the scheduled radar run.
TOPIC_PROPOSAL_ENABLED=1
TOPIC_PROPOSAL_CRON_TIME=09:00
TOPIC_PRESETS_JSON=

# Optional background Zread CLI generation for GitHub repository wiki caches.
# The remote public Zread page is tried first; set this to 0 to skip it.
ZREAD_REMOTE_ENABLED=1
ZREAD_CLI_ENABLED=1
ZREAD_CLI_BIN=zread
# Catalog + page generation can take several minutes on medium repositories.
# 0 means no hard timeout; Zread runs as a background enrichment task and
# preserves partial pages if the process exits after incremental generation.
ZREAD_CLI_TIMEOUT_SECONDS=0

# Optional read-only GBrain HTTP MCP sidecar.
GBRAIN_MCP_URL=
GBRAIN_MCP_TOKEN=

# WeWe RSS dashboard auth code, required for automatic feed.refreshArticles.
WEWE_AUTH_CODE=

# URL fetcher
URL_FETCH_MAX_BYTES=2097152
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_REDIRECTS=3

# Budget (架构 §九 风险 4)
BUDGET_TEAM_DAILY=20
BUDGET_USER_DAILY=5

# P1-A2: shared token the Web BFF must send on /api/radar/* write + read
# routes. Generate with `openssl rand -hex 32` and keep the same value in
# apps/web/.env. Leave empty only in local dev with RADAR_DISABLE_INTERNAL_TOKEN=1.
INTERNAL_SERVICE_TOKEN=
RADAR_DISABLE_INTERNAL_TOKEN=1
