# AI engine env
# 命名见 docs/contracts/env-and-scripts.md
#
# 主引擎: gpt-researcher (ADR 0004, 2026-07-27 复评通过)
# LLM 通过 LangChain provider 抽象,支持 anthropic / openai 等。
# 本地开发默认可直连 MiniMax；也可选择 cc-switch / vibeproxy 等本地兼容 proxy。
# VPS 默认 DeepSeek API；其他部署者可填写任一兼容端点和 API key。
#
# Canonical runtime routing uses RESEARCH/UTILITY/FALLBACK. Legacy slots below
# remain only as compatibility mirrors for gpt-researcher 0.15.x.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deep_research
TAVILY_API_KEY=
# Use Tavily when a key is configured; the adapter falls back to DuckDuckGo
# for missing/failed Tavily searches and keeps that degradation visible.
RETRIEVER=tavily

# The setup script prompts for provider, endpoint, key, and model. It first
# tries `${BASE_URL}/models`, then allows manual model entry. The selected
# `<provider>:<model>` is copied to all four runtime slots. Values below are
# examples only, not universal defaults.
# VPS default: DeepSeek OpenAI-compatible endpoint
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
# Direct provider profiles:
#   MINIMAX_BASE_URL=https://api.minimaxi.com/v1
#   DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Local cc-switch (Anthropic-compatible): http://localhost:15721
# Local ais-switch (OpenAI-compatible): http://localhost:15722/v1
# Local vibeproxy (OpenAI-compatible): http://localhost:8318/v1
# In --quick/fake mode setup writes anthropic:deepseek-v4-flash to all slots.
RESEARCH_LLM=minimax:MiniMax-M3
UTILITY_LLM=minimax:MiniMax-M3
# Quota, rate-limit, timeout, connection, and provider-5xx fallback used by
# every shared LLM call.
FALLBACK_LLM=deepseek:deepseek-v4-flash
LLM_USAGE_AUDIT_ENABLED=true
LLM_RETRY_ATTEMPTS=1
LLM_CIRCUIT_ENABLED=true
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=45
# Revisit score/enrichment work after a temporary provider/network outage.
# The recovery worker is bounded and uses the normal quality gates.
LLM_RECOVERY_ENABLED=1
LLM_RECOVERY_INTERVAL_SECONDS=600
LLM_RECOVERY_LIMIT=50
RADAR_ENRICHMENT_RECOVERY_ENABLED=1
RADAR_ENRICHMENT_RECOVERY_INTERVAL_SECONDS=60

# Real-browser presentation review for completed collection/deep_read
# enrichment. The worker opens the Web detail page at desktop and mobile
# viewports; failures are recorded separately from contentReviewStatus.
RADAR_RENDER_REVIEW_ENABLED=1
# Docker production delegates browser work to the Node/Chromium sidecar.
# Leave empty for native mode, where the AI process can invoke the local script.
RADAR_RENDER_REVIEW_SERVICE_URL=
RADAR_RENDER_REVIEW_BASE_URL=http://127.0.0.1:3000
RADAR_RENDER_REVIEW_INTERVAL_SECONDS=30
RADAR_RENDER_REVIEW_BATCH_SIZE=1
RADAR_RENDER_REVIEW_TIMEOUT_SECONDS=150
RADAR_RENDER_REVIEW_STALE_MINUTES=30
HUGGINGFACE_BASE_URL=https://huggingface.co
HUGGINGFACE_TIMEOUT_SECONDS=30
HUGGINGFACE_FETCH_RETRIES=2
# Content review claims use a UUID token in addition to the stale timestamp.
# This bounds recovery without allowing an old reviewer to write after takeover.
RADAR_CONTENT_REVIEW_STALE_MINUTES=30
RADAR_REVIEW_RECONCILIATION_INTERVAL_SECONDS=60
RADAR_REVIEW_RECONCILIATION_BATCH_SIZE=2

# Provider credentials. The *_LLM slots above are the runtime source of truth;
# *_MODEL values are compatibility hints for provider-specific clients.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Heavy credentials are optional and fall back to the light credentials.
ANTHROPIC_API_KEY_HEAVY=
ANTHROPIC_BASE_URL_HEAVY=

# OpenAI-compatible credentials (OpenAI, DeepSeek OpenAI API, vibeproxy).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY_HEAVY=
OPENAI_BASE_URL_HEAVY=

# Optional model-specific direct profiles; lowercase *_api_key aliases are
# also accepted for compatibility with an existing local .env.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

GH_TOKEN=

# Product Hunt GraphQL API token. Required for the producthunt radar source
# to fetch real data. Operators can mint a developer token at
# https://api.producthunt.com/v2/oauth/applications — leave blank to disable
# the source (the radar_sync_diagnostics page will surface the row as failed).
PRODUCTHUNT_API_TOKEN=

# Adapter selection (default: gpt_researcher; fake for tests/CI)
AI_ENGINE_ADAPTER=gpt_researcher

# Radar deep-dive feature flag (Phase 0+). When true, sync captures
# original content into summaries.originalMarkdown. When false, behaves
# as Week 9 (no capture, no UI surface).
RADAR_DEEPDIVE_ENABLED=true

# Worker
WORKER_LEASE_SECONDS=1920
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_RETRIES=3
WORKER_REAPER_INTERVAL_SECONDS=30
# Deep research has its own longer publication budget. It is checked before
# WORKER_JOB_TIMEOUT_SECONDS so a normal worker budget cannot discard a
# completed evidence tree during report writing or fact review.
DEEP_RESEARCH_TIMEOUT_SECONDS=1800
# Deep research reserves part of the total budget for writing and fact review.
# When this phase reaches the timebox, the report is generated from the
# evidence already captured instead of leaving the user with a timeout page.
DEEP_RESEARCH_COLLECTION_TIMEOUT_SECONDS=900
# The report writer and fact reviewer have their own bounded publication
# deadlines, so a slow provider cannot leave a deep job in writing/reviewing
# forever after the evidence tree has finished.
DEEP_REPORT_WRITE_TIMEOUT_SECONDS=180
FACT_REVIEW_TIMEOUT_SECONDS=180
# Evidence adjudication is split into independent, risk-ordered batches.
FACT_REVIEW_BATCH_SIZE=6
FACT_REVIEW_BATCH_TIMEOUT_SECONDS=45
# Heartbeat cadence for the independent fact-review run lease.
FACT_REVIEW_HEARTBEAT_SECONDS=15
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Radar concurrency
RADAR_SOURCE_CONCURRENCY=5
RADAR_CANDIDATE_CONCURRENCY=3
RADAR_LLM_CONCURRENCY=8
RADAR_SCORING_CONCURRENCY=8
RADAR_ENRICHMENT_CONCURRENCY=2
# Per-summary enrichment lease and durable retry policy. An expired lease is
# reclaimed by the recovery loop after a process crash.
RADAR_ENRICHMENT_LEASE_SECONDS=900
RADAR_ENRICHMENT_HEARTBEAT_SECONDS=60
RADAR_ENRICHMENT_MAX_ATTEMPTS=6
RADAR_ENRICHMENT_RETRY_BASE_SECONDS=300
RADAR_ENRICHMENT_RETRY_MAX_SECONDS=21600
# Source-level run lease. Candidate completion renews it; the cron/admin
# entrypoints reap expired rows before starting another batch.
RADAR_RUN_LEASE_SECONDS=900
# Automatic GitHub/Zread retries back off after a recorded failure. Admin
# force-enrichment bypasses this delay.
RADAR_GITHUB_ENRICHMENT_RETRY_SECONDS=7200
# Daily cron compensation: retry only failed/partial sources and stages.
RADAR_SOURCE_RETRIES=2
RADAR_SOURCE_RETRY_BACKOFF_SECONDS=10
# Retry an HTTP-200 page when extraction returns an empty/blocked shell.
RADAR_CONTENT_RETRIES=1
RADAR_CONTENT_RETRY_BACKOFF_SECONDS=1
RADAR_RATE_LIMIT_RETRY_BACKOFF_SECONDS=60
RADAR_ENRICHMENT_RETRIES=2
RADAR_SYNC_CRON_ENABLED=1
# P1.6: 02:00 daily full sweep anchors the tiered loop (which otherwise
# only runs due sources). Per-source cadence is governed by the
# _RADAR_DEFAULT_TIER_MINUTES table in ai_engine/server/app.py.
RADAR_SYNC_CRON_TIME=02:00
# Generate review-only topic proposals after the scheduled radar run.
TOPIC_PROPOSAL_ENABLED=1
TOPIC_PROPOSAL_CRON_TIME=09:00
TOPIC_PRESETS_JSON=

# Optional background Zread CLI generation for GitHub repository wiki caches.
# The remote public Zread page is tried first; set this to 0 to skip it.
ZREAD_REMOTE_ENABLED=1
# Root discovery is optional cache lookup; it must yield quickly so CLI resume
# can take over when the remote edge is unavailable.
ZREAD_REMOTE_ROOT_TIMEOUT_SECONDS=45
# Local fallback generator. Remote Zread is tried first; when it has no
# published directory, the installed zread CLI is attempted automatically.
ZREAD_CLI_ENABLED=1
ZREAD_CLI_BIN=zread
# Catalog + page generation can take several minutes on medium repositories.
# 0 means no hard timeout; Zread runs as a background enrichment task and
# preserves partial pages if the process exits after incremental generation.
ZREAD_CLI_TIMEOUT_SECONDS=7200
# Pause all automatic enrichment after an upstream LLM 429. The durable
# retry row becomes eligible again after this cooldown.
RADAR_ENRICHMENT_RATE_LIMIT_COOLDOWN_SECONDS=21600

# Optional read-only GBrain HTTP MCP sidecar.
GBRAIN_MCP_URL=
GBRAIN_MCP_TOKEN=

# Optional AnythingLLM radar/chat integration.
ANYTHINGLLM_URL=
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE=
ANYTHINGLLM_ENABLED=true
# Empty means all radar chats; comma-separated IDs restrict the integration.
ANYTHINGLLM_RADAR_IDS=

# WeWe RSS dashboard auth code, required for automatic feed.refreshArticles.
WEWE_AUTH_CODE=

# URL fetcher
URL_FETCH_MAX_BYTES=2097152
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_REDIRECTS=3

# Budget (架构 §九 风险 4)
BUDGET_TEAM_DAILY=20
BUDGET_USER_DAILY=5

# P1-A2: shared token the Web BFF must send on /api/radar/* write + read
# routes. Generate with `openssl rand -hex 32` and keep the same value in
# apps/web/.env. Leave empty only in local dev with RADAR_DISABLE_INTERNAL_TOKEN=1.
INTERNAL_SERVICE_TOKEN=

# Claim-scoped evidence searches are handed off in the background. The browser
# may poll for progress, but closing it must not strand a completed search
# before its evidence is merged and a new fact-review run is queued.
EVIDENCE_RECONCILIATION_ENABLED=1
EVIDENCE_RECONCILIATION_INTERVAL_SECONDS=2
RADAR_DISABLE_INTERNAL_TOKEN=1
