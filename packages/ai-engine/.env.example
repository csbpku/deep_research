# AI engine env (Week 0 锁定命名)
# 命名见 docs/contracts/env-and-scripts.md
#
# 本地开发(Week 1 起):真 key 通过本地代理走 —— vibeproxy(OpenAI 兼容,
# 127.0.0.1:8318)和 cc-switch(Anthropic 兼容,127.0.0.1:15721)。
# 详见 docs/decisions/0005-local-proxy-endpoints.md。
# 生产部署由 secrets 注入真 OPENAI_API_KEY / ANTHROPIC_API_KEY,删 OPENAI_BASE_URL / ANTHROPIC_BASE_URL。

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deep_research
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GH_TOKEN=

# Worker
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_RETRIES=3
WORKER_REAPER_INTERVAL_SECONDS=30

# URL fetcher
URL_FETCH_MAX_BYTES=2097152
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_REDIRECTS=3

# Budget（架构 §九 风险 4）
BUDGET_TEAM_DAILY=20
BUDGET_USER_DAILY=5
