# AI engine env
# 命名见 docs/contracts/env-and-scripts.md
#
# 主引擎: gpt-researcher (ADR 0004, 2026-07-27 复评通过)
# LLM 通过 LangChain provider 抽象,支持 anthropic / openai 等。
# 本地开发通过 cc-switch proxy (Anthropic 兼容, 127.0.0.1:15721)。
# 生产部署由 secrets 注入真 ANTHROPIC_API_KEY, 删 ANTHROPIC_BASE_URL。
#
# SMART_LLM 格式: <provider>:<model> (gpt-researcher 0.15.x 要求)

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deep_research
TAVILY_API_KEY=

# LLM provider config (gpt-researcher uses LangChain)
# Heavy tier (gpt-researcher pipeline):
SMART_LLM=anthropic:claude-haiku-4-5@20251001
FAST_LLM=anthropic:deepseek-v4-flash
STRATEGIC_LLM=anthropic:claude-haiku-4-5@20251001
# Light tier (brief summaries, distilled scorer, chat follow-ups):
BRIEF_LLM=anthropic:deepseek-v4-flash

# Anthropic (via LangChain ChatAnthropic) — light credentials
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=deepseek-v4-flash

# Heavy-tier credentials (Shopee compass gateway). When unset, the
# heavy tier transparently falls back to ANTHROPIC_API_KEY/ANTHROPIC_BASE_URL
# above (single-key dev/CI mode).
ANTHROPIC_API_KEY_HEAVY=
ANTHROPIC_BASE_URL_HEAVY=

# OpenAI (fallback provider, optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

GH_TOKEN=

# Adapter selection (default: gpt_researcher; fake for tests/CI)
AI_ENGINE_ADAPTER=gpt_researcher

# Radar deep-dive feature flag (Phase 0+). When true, sync captures
# original content into summaries.originalMarkdown. When false, behaves
# as Week 9 (no capture, no UI surface).
RADAR_DEEPDIVE_ENABLED=true

# Worker
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_RETRIES=3
WORKER_REAPER_INTERVAL_SECONDS=30

# URL fetcher
URL_FETCH_MAX_BYTES=2097152
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_REDIRECTS=3

# Budget (架构 §九 风险 4)
BUDGET_TEAM_DAILY=20
BUDGET_USER_DAILY=5
