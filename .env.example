# =============================================================================
# Deep Research — root-level .env template (used by docker compose)
# =============================================================================
#
# Copy this to .env, fill in the blanks, then run:
#   docker compose -f infra/docker-compose.yml up -d
#
# ⚠️  Variables marked REQUIRED MUST be set, or docker compose will refuse to start.
# ⚠️  Variables marked (secret) MUST NOT be committed to version control.
#
# Full contract: docs/contracts/env-and-scripts.md

# ── DATABASE ─────────────────────────────────────────────────────────────────

# REQUIRED  Postgres superuser password (used by compose for all services).
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=change-me-to-a-strong-random-value

# ── WEB (apps/web) ───────────────────────────────────────────────────────────

# REQUIRED  NextAuth session signing key (min 8 chars).
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=change-me-to-a-strong-random-value

# Public-facing URL of your deployment (no trailing slash).
# Local dev: http://localhost:3000   VPS: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# OPTIONAL. When both are empty, Google login is disabled but invite-based
# email/password activation and login remain available. If configured, the
# redirect URI MUST be registered as:
#   {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# REQUIRED  Comma-separated list of email domains allowed to activate/sign in.
# Example: mycompany.com,myothercompany.com
ALLOWED_EMAIL_DOMAINS=

# REQUIRED  Shared invite code for first-time password account activation.
# Keep this secret and share it only with allowlisted users.
AUTH_INVITE_CODE=

# Optional initial Admin. Defaults to shaobo.chen@shopee.com and must belong to
# ALLOWED_EMAIL_DOMAINS. Use "off" to disable bootstrap.
BOOTSTRAP_ADMIN_EMAIL=shaobo.chen@shopee.com

# REQUIRED  Shared Web -> AI Engine token for Admin-triggered sync/topic jobs.
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=change-me-to-a-strong-random-value


# ── AI ENGINE (packages/ai-engine) ──────────────────────────────────────────

# LLM credentials. Use either the Anthropic-compatible pair or the
# OpenAI-compatible pair, matching the provider prefix in *_LLM.
ANTHROPIC_API_KEY=

# Optional  Custom Anthropic-compatible API base URL (e.g. local proxy).
# Leave empty to use the default Anthropic endpoint.
ANTHROPIC_BASE_URL=

# OpenAI-compatible API (ais-switch, vibeproxy, OpenAI, DeepSeek OpenAI API).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# REQUIRED  Web search API key (for AI research source discovery).
# Get one at https://tavily.com — or switch RETRIEVER to duckduckgo.
TAVILY_API_KEY=

# ── LLM model selection ──────────────────────────────────────────────────────

# scripts/setup.sh queries the provider's /models endpoint and lets you select
# a model (or enter an id manually), then writes the selected <provider>:<model>
# to all four slots. These are examples only and must be supported by the
# configured compatible endpoint. Re-running setup preserves the selection.
RESEARCH_LLM=minimax:MiniMax-M3
UTILITY_LLM=minimax:MiniMax-M3
# Quota/rate-limit fallback used by every shared LLM call.
FALLBACK_LLM=deepseek:deepseek-v4-flash
LLM_USAGE_AUDIT_ENABLED=true
LLM_RETRY_ATTEMPTS=1
LLM_CIRCUIT_ENABLED=true
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=45

# ── Heavy-tier credentials (optional — fall back to ANTHROPIC_* above) ──────

# If you use a separate gateway for the heavy (gpt-researcher) pipeline,
# set these. Otherwise leave empty and the light-tier key is reused.
ANTHROPIC_API_KEY_HEAVY=
ANTHROPIC_BASE_URL_HEAVY=

# Optional model-specific direct profiles. Local compatible proxy mode still
# uses the generic OPENAI_* / ANTHROPIC_* variables above.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Adapter ──────────────────────────────────────────────────────────────────

# "gpt_researcher" (default, real AI) or "fake" (no keys, deterministic output).
AI_ENGINE_ADAPTER=gpt_researcher

# ── Web search ───────────────────────────────────────────────────────────────

# Retriever backend for AI research: "tavily" or "duckduckgo".
RETRIEVER=tavily

# ── Radar source tokens (optional) ───────────────────────────────────────────

# GitHub personal access token — improves API rate limits for radar sources.
GH_TOKEN=

# ProductHunt API token — enables the ProductHunt radar source.
PRODUCTHUNT_API_TOKEN=

# ── Topic operations ─────────────────────────────────────────────────────────

# Review-only topic proposals; approval is still required in Admin.
TOPIC_PROPOSAL_ENABLED=1
TOPIC_PROPOSAL_CRON_TIME=09:00
TOPIC_PRESETS_JSON=

# ── Optional GBrain knowledge sidecar ────────────────────────────────────────
# Read-only HTTP MCP adapter; deep-research remains the system of record.
GBRAIN_MCP_URL=
GBRAIN_MCP_TOKEN=

# Optional AnythingLLM radar/chat integration.
ANYTHINGLLM_URL=
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE=
ANYTHINGLLM_ENABLED=true
ANYTHINGLLM_RADAR_IDS=

# ── Operational tuning (edit only if you know what you're doing) ─────────────

# Worker
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_RETRIES=3
WORKER_REAPER_INTERVAL_SECONDS=30

# URL fetcher limits
URL_FETCH_MAX_BYTES=2097152
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_REDIRECTS=3

# Daily quotas
BUDGET_TEAM_DAILY=20
BUDGET_USER_DAILY=5
