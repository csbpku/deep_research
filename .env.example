# =============================================================================
# Deep Research — root-level .env template (used by docker compose)
# =============================================================================
#
# Copy this to .env, fill in the blanks, then run:
#   docker compose -f infra/docker-compose.yml up -d
#
# ⚠️  Variables marked REQUIRED MUST be set, or docker compose will refuse to start.
# ⚠️  Variables marked (secret) MUST NOT be committed to version control.
#
# Full contract: docs/contracts/env-and-scripts.md

# ── DATABASE ─────────────────────────────────────────────────────────────────

# REQUIRED  Postgres superuser password (used by compose for all services).
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=change-me-to-a-strong-random-value

# ── WEB (apps/web) ───────────────────────────────────────────────────────────

# REQUIRED  NextAuth session signing key (min 8 chars).
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=change-me-to-a-strong-random-value

# Public-facing URL of your deployment (no trailing slash).
# Local dev: http://localhost:3000   VPS: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# REQUIRED  Google OAuth 2.0 credentials (from Google Cloud Console).
# The redirect URI MUST be registered as:
#   {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# REQUIRED  Comma-separated list of email domains allowed to sign in.
# Example: mycompany.com,myothercompany.com
ALLOWED_EMAIL_DOMAINS=

# ── AI ENGINE (packages/ai-engine) ──────────────────────────────────────────

# REQUIRED  Anthropic API key for LLM calls.
# Both light-tier (brief summaries / chat) and heavy-tier (gpt-researcher
# pipeline) use this key by default.  Set *_HEAVY variants below if you need
# separate credentials (e.g. Shopee compass gateway).
ANTHROPIC_API_KEY=

# Optional  Custom Anthropic-compatible API base URL (e.g. local proxy).
# Leave empty to use the default Anthropic endpoint.
ANTHROPIC_BASE_URL=

# REQUIRED  Web search API key (for AI research source discovery).
# Get one at https://tavily.com — or switch RETRIEVER to duckduckgo.
TAVILY_API_KEY=

# ── LLM model selection (optional — defaults are tuned for cost/quality) ─────

# Heavy-tier pipeline models (gpt-researcher):
SMART_LLM=anthropic:claude-haiku-4-5@20251001
FAST_LLM=anthropic:deepseek-v4-flash
STRATEGIC_LLM=anthropic:claude-haiku-4-5@20251001

# Light-tier model (brief summaries, scoring, chat follow-ups):
BRIEF_LLM=anthropic:deepseek-v4-flash

# ── Heavy-tier credentials (optional — fall back to ANTHROPIC_* above) ──────

# If you use a separate gateway for the heavy (gpt-researcher) pipeline,
# set these. Otherwise leave empty and the light-tier key is reused.
ANTHROPIC_API_KEY_HEAVY=
ANTHROPIC_BASE_URL_HEAVY=

# ── Adapter ──────────────────────────────────────────────────────────────────

# "gpt_researcher" (default, real AI) or "fake" (no keys, deterministic output).
AI_ENGINE_ADAPTER=gpt_researcher

# ── Web search ───────────────────────────────────────────────────────────────

# Retriever backend for AI research: "tavily" or "duckduckgo".
RETRIEVER=tavily

# ── Radar source tokens (optional) ───────────────────────────────────────────

# GitHub personal access token — improves API rate limits for radar sources.
GH_TOKEN=

# ProductHunt API token — enables the ProductHunt radar source.
PRODUCTHUNT_API_TOKEN=

# ── Operational tuning (edit only if you know what you're doing) ─────────────

# Worker
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_RETRIES=3
WORKER_REAPER_INTERVAL_SECONDS=30

# URL fetcher limits
URL_FETCH_MAX_BYTES=2097152
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_REDIRECTS=3

# Daily quotas
BUDGET_TEAM_DAILY=20
BUDGET_USER_DAILY=5
